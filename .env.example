# Free market data key from https://www.tiingo.com (server-only). Empty = sample prices.
TIINGO_API_KEY=
# Accounts and cross-device sync (free Supabase project). These two are safe to expose; row-level security protects data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only, for the weekday auto-invest cron (never expose these). Supabase > Settings > API > service_role.
SUPABASE_SERVICE_ROLE_KEY=
CRON_SECRET=
